# ==============================================================================
# Environment Configuration Example for Predictive Maintenance Platform
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
# In local dev with fallback mode, leave blank or set to postgresql://postgres:postgres@localhost:5432/predictive_maintenance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/predictive_maintenance
DB_HOST=localhost
DB_PORT=5432
DB_NAME=predictive_maintenance
DB_USER=postgres
DB_PASSWORD=postgres

# ML Model Paths (relative to backend root)
ML_MODEL_PATH=../ml/models/model.joblib
ML_SCALER_PATH=../ml/models/scaler.joblib
ML_ANOMALY_MODEL_PATH=../ml/models/isolation_forest.joblib

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
